# ── LLM Configuration ─────────────────────────────────────────────────────────
# Primary LLM provider: "gemini" or "openai"
LLM_PRIMARY=gemini
LLM_FALLBACK=openai

# Google Gemini (primary — faster, cheaper)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Hard timeout in ms — must stay within 100ms total budget
GEMINI_TIMEOUT_MS=90

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90

# ── Redis Configuration ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=3600

# ── Semantic Cache ────────────────────────────────────────────────────────────
# Cosine similarity threshold for semantic cache HIT (0.0–1.0)
# 0.92 = queries must be ~92% similar to reuse cached response
CACHE_SIMILARITY_THRESHOLD=0.92
# Max in-process LRU cache entries (~3MB RAM for 2000 × 384-dim float32)
SEMANTIC_CACHE_MAX_ENTRIES=2000

# ── Application Configuration ─────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_CACHE=true
ENABLE_MONITORING=true

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=./data
INDEX_DIR=./data/indexes
